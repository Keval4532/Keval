{
  "buildCommand": "cd frontend && yarn build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|static/|favicon\\.ico|manifest\\.json|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
